msgctxt "block keyword"
msgid "outro"
msgstr "outro"

#: src/after/block.json src/row/block.json src/step/block.json
#: src/story/block.json
msgctxt "block keyword"
msgid "story"
msgstr "story"

#: src/row/block.json
msgctxt "block title"
msgid "Scrollytelling Row"
msgstr "Scrollytelling-Reihe"

#: src/row/block.json
msgctxt "block description"
msgid "A row of steps inside a story. Its steps pass sideways while the visitor keeps scrolling down."
msgstr "Eine Reihe von Schritten innerhalb einer Story. Ihre Schritte ziehen seitwärts vorbei, während der Besucher weiter nach unten scrollt."

#: src/row/block.json
msgctxt "block keyword"
msgid "row"
msgstr "reihe"

#: src/row/block.json
msgctxt "block keyword"
msgid "horizontal"
msgstr "horizontal"

#: src/step/block.json
msgctxt "block title"
msgid "Scrollytelling Step"
msgstr "Scrollytelling-Schritt"

#: src/step/block.json
msgctxt "block description"
msgid "One step of the story: text that scrolls across the medium belonging to it."
msgstr "Ein Schritt der Story: Text, der über das zugehörige Medium scrollt."

#: src/step/block.json
msgctxt "block keyword"
msgid "step"
msgstr "schritt"

#: src/story/block.json
msgctxt "block title"
msgid "Scrollytelling Story"
msgstr "Scrollytelling-Story"

#: src/story/block.json
msgctxt "block description"
msgid "A full-screen medium that stays in place while the text steps scroll across it."
msgstr "Ein bildschirmfüllendes Medium, das an Ort und Stelle bleibt, während die Textschritte darüber scrollen."

#: src/story/block.json
msgctxt "block keyword"
msgid "scroll"
msgstr "scroll"

#: src/story/block.json
msgctxt "block keyword"
msgid "sticky"
msgstr "sticky"

