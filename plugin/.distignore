# Files and directories that stay out of the release ZIP and the SVN export.
.distignore
.DS_Store
Thumbs.db
*.swp
*.zip

# Block sources: the editor and front end load the compiled files in build/.
src/

# Translations: the WordPress.org plugin team rejects packages with bundled
# translation files. Languages are handled through translate.wordpress.org;
# from languages/ only the .pot template is shipped.
languages/*.po
languages/*.mo
languages/*.json
languages/*.l10n.php
