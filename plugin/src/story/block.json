{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "scrollstage/story",
	"version": "2.8.2",
	"title": "Scrollstage Story",
	"category": "scrollstage",
	"icon": "images-alt2",
	"description": "A full-screen medium that stays in place while the text steps scroll across it.",
	"keywords": [ "scrollytelling", "story", "scroll", "sticky" ],
	"textdomain": "scrollstage",
	"supports": {
		"anchor": true,
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": true,
			"gradients": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		}
	},
	"attributes": {
		"textPosition": {
			"type": "string",
			"default": "center"
		},
		"textWidth": {
			"type": "number",
			"default": 45
		},
		"overlayOpacity": {
			"type": "number",
			"default": 35
		},
		"mediaFit": {
			"type": "string",
			"default": "cover"
		},
		"limitStage": {
			"type": "boolean",
			"default": false
		},
		"pullContent": {
			"type": "boolean",
			"default": false
		},
		"stepAlign": {
			"type": "string",
			"default": "center"
		},
		"transition": {
			"type": "string",
			"default": "fade"
		},
		"textEffect": {
			"type": "string",
			"default": "none"
		},
		"stickyOffset": {
			"type": "number",
			"default": 0
		},
		"minStepHeight": {
			"type": "number",
			"default": 100
		}
	},
	"providesContext": {
		"scrollstage/textEffect": "textEffect"
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
