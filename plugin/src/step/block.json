{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "scrollstage/step",
	"version": "2.8.1",
	"title": "Scrollstage Step",
	"category": "scrollstage",
	"icon": "align-left",
	"description": "One step of the story: text that scrolls across the medium belonging to it.",
	"keywords": [ "scrollytelling", "step", "story" ],
	"textdomain": "scrollstage",
	"parent": [ "scrollstage/story", "scrollstage/row" ],
	"supports": {
		"anchor": true,
		"html": false,
		"reusable": false,
		"color": {
			"background": true,
			"text": true,
			"__experimentalSkipSerialization": [ "background" ]
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalSkipSerialization": [ "padding" ]
		},
		"shadow": {
			"__experimentalSkipSerialization": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"textAlign": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalSkipSerialization": true
		}
	},
	"attributes": {
		"mediaId": {
			"type": "number",
			"default": 0
		},
		"mediaUrl": {
			"type": "string",
			"default": ""
		},
		"mediaAlt": {
			"type": "string",
			"default": ""
		},
		"mediaType": {
			"type": "string",
			"default": "image"
		},
		"focalPoint": {
			"type": "object"
		},
		"textEffect": {
			"type": "string",
			"default": ""
		},
		"minHeight": {
			"type": "number",
			"default": 0
		}
	},
	"usesContext": [ "scrollstage/textEffect", "scrollstage/inRow" ],
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
