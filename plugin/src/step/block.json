{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gorres-scrollytelling/step",
	"version": "2.12.0",
	"title": "Scrollytelling Step",
	"category": "gorres-scrollytelling",
	"icon": "align-left",
	"description": "One step of the story: text that scrolls across the medium belonging to it.",
	"keywords": [ "scrollytelling", "step", "story" ],
	"textdomain": "gorres-scrollytelling",
	"parent": [ "gorres-scrollytelling/story", "gorres-scrollytelling/row" ],
	"supports": {
		"anchor": true,
		"html": false,
		"reusable": false,
		"color": {
			"background": true,
			"text": true,
			"__experimentalSkipSerialization": [ "background" ]
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalSkipSerialization": [ "padding" ]
		},
		"shadow": {
			"__experimentalSkipSerialization": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"textAlign": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalSkipSerialization": true
		}
	},
	"attributes": {
		"mediaId": {
			"type": "number",
			"default": 0
		},
		"mediaUrl": {
			"type": "string",
			"default": ""
		},
		"mediaAlt": {
			"type": "string",
			"default": ""
		},
		"mediaType": {
			"type": "string",
			"default": "image"
		},
		"focalPoint": {
			"type": "object"
		},
		"portraitId": {
			"type": "number",
			"default": 0
		},
		"portraitUrl": {
			"type": "string",
			"default": ""
		},
		"portraitFocalPoint": {
			"type": "object"
		},
		"mediaScroll": {
			"type": "boolean",
			"default": false
		},
		"textEffect": {
			"type": "string",
			"default": ""
		},
		"minHeight": {
			"type": "number",
			"default": 0
		},
		"textPosition": {
			"type": "string",
			"default": ""
		},
		"stepAlign": {
			"type": "string",
			"default": ""
		},
		"pinText": {
			"type": "boolean",
			"default": false
		}
	},
	"usesContext": [
		"gorres-scrollytelling/textEffect",
		"gorres-scrollytelling/inRow",
		"gorres-scrollytelling/mediaFit",
		"gorres-scrollytelling/firstStep"
	],
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
