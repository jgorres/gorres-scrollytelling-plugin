msgid "Room for a fixed menu above the media."
msgstr ""

#: src/story/edit.js:230
msgid "Decides how long a medium stays in place."
msgstr ""

#: src/story/edit.js:249
msgid "Transition"
msgstr ""

#: src/story/edit.js:250
msgid "With “None” the media switch instantly. Systems asking for reduced motion never cross-fade."
msgstr ""

#: src/story/edit.js:257
msgid "Cross-fade"
msgstr ""

