#: src/step/edit.js:422
msgid "Keep the text box in place"
msgstr ""

#: src/step/edit.js:426
msgid "The text box stays where it is on the screen while the visitor scrolls through this step, and leaves at the top when the step ends. It needs a step taller than the screen: set a height above 100 percent under \"Height\". The text box then goes without a text effect. Front end only; has no effect inside a row."
msgstr ""

#: src/step/edit.js:437
msgid "Height"
msgstr ""

#: src/step/edit.js:442
msgid "Use the step height of the story"
msgstr ""

#: src/step/edit.js:446
msgid "Switch off to give this step a height of its own. Lower steps without a medium let several text boxes scroll across the same medium one after the other. Front end only; has no effect inside a row."
msgstr ""

#: src/step/edit.js:460
#: src/story/edit.js:243
msgid "Step height in percent of the screen height"
msgstr ""

#: src/step/edit.js:464
msgid "A text box taller than this makes the step as tall as it needs."
