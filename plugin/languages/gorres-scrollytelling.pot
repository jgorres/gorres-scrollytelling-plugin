msgid "On narrow screens the boxes always use the full width."
msgstr ""

#: src/story/edit.js:118
msgid "Vertical position"
msgstr ""

#: src/story/edit.js:142
msgid "Media"
msgstr ""

#: src/story/edit.js:145
msgid "Media fit"
msgstr ""

#: src/story/edit.js:146
msgid "“Fill the frame” crops the medium to the size of the screen, “Show the whole medium” leaves margins free."
msgstr ""

#: src/story/edit.js:153
msgid "Fill the frame"
msgstr ""

#: src/story/edit.js:160
msgid "Show the whole medium"
msgstr ""

#: src/story/edit.js:174
msgid "Limit the stage to the medium"
msgstr ""

#: src/story/edit.js:178
msgid "Otherwise the media use the full width and the text can end up beside the medium. The width follows the narrowest medium of the story. Front end only."
msgstr ""

#: src/story/edit.js:191
msgid "Pull up the following content"
msgstr ""

#: src/story/edit.js:195
msgid "The content after the story appears right below the stage from the first step on and only scrolls on once the story ends. Front end only."
msgstr ""

#: src/story/edit.js:207
msgid "Dimming in percent"
msgstr ""

#: src/story/edit.js:211
msgid "Sits on top of the media so that text stays readable."
msgstr ""

#: src/story/edit.js:225
msgid "Offset from the top (px)"
msgstr ""

#: src/story/edit.js:229
msgid "Room for a fixed menu above the media."
msgstr ""

#: src/story/edit.js:247
msgid "Decides how long a medium stays in place."
msgstr ""

#: src/story/edit.js:266
msgid "Transition"
msgstr ""

#: src/story/edit.js:267
msgid "With “None” the media switch instantly. Systems asking for reduced motion never cross-fade."
msgstr ""

#: src/story/edit.js:274
msgid "Cross-fade"
msgstr ""

#: src/story/edit.js:292
msgid "How the text boxes appear and disappear while scrolling. A step can set its own effect. Front end only; systems asking for reduced motion show no effect."
msgstr ""

